# CRISPR Environment Configuration
#
# For development: Copy this file to .env
# For production: See docker-compose.yaml for required variables

# =============================================================================
# Development Settings
# =============================================================================

# Database
DATABASE_URL=postgres://crispr:crispr@localhost:5432/crispr_dev

# GitHub (PAT mode for development)
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LLM API Keys (optional - can be configured via UI)
ANTHROPIC_API_KEY=sk-ant-a
OPENAI_API_KEY=sk-xxxxx

# Config file path (optional, defaults to config/config.dev.yaml)
# CRISPR_CONFIG=config/config.dev.yaml

# =============================================================================
# Production Settings (for docker-compose.yaml)
# =============================================================================

# Required:
# POSTGRES_PASSWORD=your-secure-database-password
# CRISPR_ENCRYPTION_KEY=<base64-encoded-32-byte-key>  # Generate: openssl rand -base64 32

# GitHub (choose one):
# GITHUB_PAT=ghp_your_personal_access_token
# -- or --
# GITHUB_CLIENT_ID=your-oauth-client-id
# GITHUB_CLIENT_SECRET=your-oauth-client-secret

# LLM (at least one required):
# ANTHROPIC_API_KEY=sk-ant-your-key
# OPENAI_API_KEY=sk-your-key

# Optional - Slack:
# SLACK_CLIENT_ID=your-slack-client-id
# SLACK_CLIENT_SECRET=your-slack-client-secret

# Optional - S3 storage:
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1

# Optional - MinIO (local S3):
# MINIO_ROOT_USER=minio
# MINIO_ROOT_PASSWORD=minio123
